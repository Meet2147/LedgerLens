<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Runs fully sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read the statements the user picks and write the exports they save. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Outgoing connections are used ONLY to validate a Polar license key. Statement
	     contents are always processed locally and are never sent anywhere. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
